# ==========================================
# Resume-Nextgen2ai Backend Environment Configuration Example
# ==========================================

# Port Configuration (Production: 8093)
PORT=8093

# Django Secret Key
SECRET_KEY=your-django-secret-key

# Debug Mode (False in production)
DEBUG=True

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Razorpay Payment Gateway Credentials (₹29 PDF Download)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Google OAuth Credentials (Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin Panel Authorized Super-Admin Emails
ADMIN_EMAILS=admin@nextgen2ai.com
